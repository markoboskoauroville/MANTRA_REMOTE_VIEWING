#!/bin/zsh
# pixel-screen — the Pixel 7's screen on the Mac with a real mouse and keyboard (Marko, 26.10.2026: "I want to see my
# mouse on the screen ... I press and I drag, and it acts like ... keeping my left mouse button down ... create both a
# remote keyboard and a remote mouse"). scrcpy's UHID mode: Android sees a USB mouse and keyboard, draws the mouse
# arrow, a press-and-drag is the left button held, the Mac keyboard types into the phone (the PIN too, typed by him).
# The window catches the mouse while you work in it; Left Option or Left Cmd lets it go. Stop: pixel-screen stop.
# The cable first, else the tunnel (Tailscale, adb on 5555).
SERIAL=${PIXEL_SERIAL:-41241FDH2S10SJ}
ADB=~/Library/Android/sdk/platform-tools/adb
# a frozen window ignores the polite signal (seen 26.10.2026): the force follows after a second
close_all() { pkill -f "scrcpy -s .*--window-title PIXEL 7" 2>/dev/null; sleep 1; pkill -9 -f "scrcpy -s .*--window-title PIXEL 7" 2>/dev/null; }
if [[ "$1" == stop ]]; then close_all; echo "pixel-screen stopped"; exit 0; fi
# pixel-screen           the normal window (the Mac pointer free)
# pixel-screen mouse     a real mouse on the phone (captured; Left Option frees it)
# no cable: the home Wi-Fi address first (straight, fastest at home), then the tunnel (anywhere)
if ! $ADB -s $SERIAL get-state >/dev/null 2>&1; then
  SERIAL=""
  for A in ${PIXEL_LAN:-192.168.1.101:5555} 100.70.23.53:5555; do
    $ADB connect $A >/dev/null 2>&1; sleep 1
    if $ADB -s $A get-state >/dev/null 2>&1; then SERIAL=$A; break; fi
  done
  [[ -z $SERIAL ]] && { echo "the Pixel answers neither on the Wi-Fi nor through the tunnel (adb tcpip 5555 lost by a restart?)"; exit 1; }
fi
close_all
# Marko, 26.10.2026: "my screen copy is always in this mouse mode, which is very annoying ... How to switch between
# two modes": by default the Mac's pointer stays free (a click is a tap, a drag a swipe; works from Computer Remote
# too) and the keyboard types into the phone; `pixel-screen mouse` gives the phone a real mouse (its arrow; the
# window holds the pointer until Left Option)
if [[ "$1" == mouse ]]; then MODE="--mouse=uhid"; TITLE="PIXEL 7 · PHONE MOUSE (Left Option frees it)"
else MODE="--mouse=sdk"; TITLE="PIXEL 7"; fi
nohup scrcpy -s $SERIAL --window-title "$TITLE" --no-audio --max-size 1200 \
      $MODE --keyboard=uhid >/tmp/pixel-screen.log 2>&1 &
disown
echo "pixel-screen on $SERIAL (log /tmp/pixel-screen.log)"
